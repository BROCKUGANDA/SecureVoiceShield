generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "sqlite"
}

// Every state-changing write stores the exact decision it produced.
// Money values never appear here: the demo never touches real payments.
model Decision {
  id            String   @id @default(cuid())
  idemKey       String?  @unique
  idemBodyHash  String?
  kind          String // number_check | voice_check | guardian | verified_lookup
  subject       String // HMAC of the subject, or an opaque id — never a raw number
  subjectMasked String
  verdict       String // clear | caution | danger | inconclusive | verified
  reasons       String // JSON string[] of reason codes
  action        String // allow | step_up | hold | review
  signals       String // JSON snapshot (values only, never audio)
  latencyMs     Int      @default(0)
  auditSeq      Int
  // The tenant that owns this decision in the business tier (17, isolation).
  tenantId      String?
  policyVersion String   @default("ug-public-2026.10.2")
  expiresAt     DateTime? // a decision is never reused after this (10, section 2)
  createdAt     DateTime @default(now())
}

// Hash-chained evidence log: each entry links to the previous one per cell.
model AuditEntry {
  id            String   @id @default(cuid())
  seq           Int      @unique
  cell          String   @default("ug")
  actor         String
  action        String
  resource      String
  reasonCodes   String   @default("[]")
  policyVersion String
  inputDigest   String
  modelVersions String   @default("{}")
  traceId       String?
  prevHash      String
  entryHash     String
  sig           String? // ES256 signature over the entry hash (13, section 6.2)
  createdAt     DateTime @default(now())
}

// Transactional outbox (09, principle A-4): the event is written in the same
// transaction as the state change it describes, so an event can never exist
// without its decision, nor a decision without its event.
model OutboxEvent {
  id        String   @id // event id, also the CloudEvents id
  seq       Int      @unique
  type      String // me.securevoiceai.shield.<name>.v1
  subject   String // ordering key: decision id, session id, number hash
  lane      String   @default("standard")
  cell      String   @default("ug")
  payload   String // CloudEvents data — IDs, codes and times only, never personal data
  createdAt DateTime @default(now())
}

// A number owner can challenge a label (13, section 8). The request is only
// filed once possession of the number is proven; the review deadline runs
// from the moment it is verified.
model Appeal {
  id                    String    @id @default(cuid())
  numberHash            String
  reason                String
  status                String    @default("pending_verification") // pending_verification | open | upheld | rejected
  decision              String? // upheld | rejected — the outcome of the review
  verificationCode      String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int       @default(0)
  requiresExtraCheck    Boolean   @default(false)
  reviewDeadline        DateTime
  createdAt             DateTime  @default(now())
  verifiedAt            DateTime?
  decidedAt             DateTime?

  @@index([numberHash])
}

// A sealed segment of the audit chain (13, section 6.2; 09, rule T-10).
//
// The chain head is time-stamped daily by two independent RFC 3161
// authorities in production. This build has no time-stamping authority, so
// the anchor is signed by the cell's own key and the record says which
// authority it carries — an auditor can tell the two apart.
model ChainAnchor {
  id            String   @id @default(cuid())
  cell          String   @default("ug")
  upToSeq       Int
  headHash      String
  segmentDigest String
  authority     String   @default("cell-key")
  signature     String?
  prevAnchorHash String?
  anchorHash    String
  createdAt     DateTime @default(now())

  @@index([cell, upToSeq])
}

// A tenant is a bank or telco with business-API access. Credentials are
// OAuth 2.0 client credentials with private_key_jwt, and the access token
// is bound to the client's mTLS certificate (17, 12).
model Tenant {
  id                     String   @id @default(cuid())
  name                   String
  clientId               String   @unique
  status                 String   @default("active")
  // The client's public keys (JWKS), as JSON.
  jwks                   String
  // RFC 8705 binding: the thumbprint of the client's mTLS certificate.
  certificateThumbprint String?
  // Comma-separated scopes.
  scopes                 String   @default("assess:read")
  policyVersion          String   @default("ug-banking-2026.10.1")
  createdAt              DateTime @default(now())
}

// A tenant's own label for a decision (13, section 5.3). Unlabelled
// decisions count as unknown, never as genuine.
model Outcome {
  id            String   @id @default(cuid())
  tenantId      String
  decisionId    String
  outcome       String // fraud_confirmed | genuine | unknown
  fraudType     String?
  lossAmountMinor Int?
  lossCurrency  String?
  confirmedAt   DateTime?
  createdAt     DateTime @default(now())

  @@unique([tenantId, decisionId])
  @@index([tenantId, createdAt])
}

// A signed evidence pack for a dispute, a complaint or a regulator
// (13, section 6.3). The pack itself lives in short-lived object storage.
model EvidencePack {
  id           String   @id @default(cuid())
  tenantId     String
  decisionId   String
  objectHandle String
  digest       String
  signature    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([tenantId, createdAt])
}

// Short-lived objects handed out by signed link — evidence packs, exports.
model StoredObject {
  handle     String    @id
  objectKey  String
  value      String
  digest     String
  expiresAt  DateTime
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

// A confirmed scam report. One row per independent reporter per number, so
// one caller cannot inflate a number's reputation (09, reputation poisoning).
model ScamReport {
  id           String   @id @default(cuid())
  numberHash   String
  reporterHash String
  note         String?
  createdAt    DateTime @default(now())

  @@unique([numberHash, reporterHash])
  @@index([numberHash])
}

// Registry of real outbound bank calls: "Was that call real?" looks up here.
// Numbers are stored as HMACs; the bank name and market are what is displayed.
model VerifiedCall {
  id           String   @id @default(cuid())
  bankName     String
  market       String // AE | KE | UG | TZ
  e164Hash     String   @unique
  minutesValid Int      @default(15)
  createdAt    DateTime @default(now())
}

// Guardian sessions are server state: the media fork decides the scenario,
// so the client never gets to choose the outcome of a live call.
model GuardianSession {
  id            String   @id
  scenario      String
  scenarioSource String  @default("media-fork")
  language      String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  completedAt   DateTime?
}

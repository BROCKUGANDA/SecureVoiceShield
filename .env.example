# SecureVoice Shield — environment configuration
# Copy this file to .env (local) or inject via your secret manager in production.
# Every variable is documented with its purpose, default and where it is used.
# Variables marked REQUIRED must be set for the app to start in production.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development                       # development | production | test
PORT=3000                                  # HTTP listen port
LOG_LEVEL=info                             # trace | debug | info | warn | error

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# ---------------------------------------------------------------------------
# Production: postgres://user:pass@host:5432/shield?sslmode=require
DATABASE_URL=postgresql://shield:shield@localhost:5432/shield
# Read replica (optional, for analytics/reporting)
DATABASE_READ_URL=
# Shadow database for Prisma migrations
SHADOW_DATABASE_URL=

# ---------------------------------------------------------------------------
# Cache / queues (Valkey 8 / Redis-compatible)
# ---------------------------------------------------------------------------
VALKEY_URL=redis://localhost:6379
VALKEY_TLS=false

# ---------------------------------------------------------------------------
# Object storage (S3-compatible, WORM for evidence)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_EVIDENCE=shield-evidence
S3_BUCKET_AUDIO=shield-audio-tmp
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Object lock (WORM) retention days for evidence packs
EVIDENCE_RETENTION_DAYS=2555

# ---------------------------------------------------------------------------
# Cell / region identity
# ---------------------------------------------------------------------------
SHIELD_CELL=ug                             # ae | ke | ug | tz
SHIELD_REGION=ug                           # ae | ke | ug | tz
SHIELD_BASE_URL=https://ug.api.shield.securevoiceai.me
SHIELD_SANDBOX_BASE_URL=https://sandbox.ug.api.shield.securevoiceai.me

# ---------------------------------------------------------------------------
# Phone-number hashing pepper (HSM-held in prod)
# ---------------------------------------------------------------------------
SHIELD_CELL_PEPPER=shield-ug-sandbox-pepper

# ---------------------------------------------------------------------------
# Audit signing (ES256) — generate with: bun run keygen
# ---------------------------------------------------------------------------
SHIELD_SIGNING_KEY="<paste the generated PEM here>"
SHIELD_SIGNING_KEY_ID=audit-2026-10

# ---------------------------------------------------------------------------
# Sandbox tenant (generate with: bun run seed:tenant)
# ---------------------------------------------------------------------------
SHIELD_SANDBOX_TENANT_PRIVATE_KEY="<paste the generated PEM here>"
SHIELD_SANDBOX_TENANT_CERT_THUMBPRINT="<the registered thumbprint>"

# ---------------------------------------------------------------------------
# ElevenLabs (conversation plane + classifier)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_GUARDIAN_UG_LG=
ELEVENLABS_AGENT_ID_GUARDIAN_UG_SW=
ELEVENLABS_AGENT_ID_GUARDIAN_UG_EN=
ELEVENLABS_AGENT_ID_HELPER_UG=
ELEVENLABS_VOICE_ID_UG_LG=
ELEVENLABS_VOICE_ID_UG_SW=
ELEVENLABS_VOICE_ID_UG_EN=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_CLASSIFIER_ENABLED=false        # D1 provider-scoped detector
ELEVENLABS_ZERO_RETENTION=true

# ---------------------------------------------------------------------------
# Detection service (Python FastAPI + ONNX)
# ---------------------------------------------------------------------------
DETECT_SERVICE_URL=http://localhost:8001
DETECT_SERVICE_TIMEOUT_MS=800
D2_VENDOR_URL=
D2_VENDOR_API_KEY=
D3_MODEL_VERSION=2026.10.2

# ---------------------------------------------------------------------------
# Telco adapters (CAMARA / operator direct)
# ---------------------------------------------------------------------------
TELCO_AGGREGATOR_URL=
TELCO_AGGREGATOR_API_KEY=
TELCO_AGGREGATOR_TIMEOUT_MS=600
MTN_UGANDA_API_URL=
MTN_UGANDA_API_KEY=
MTN_UGANDA_API_SECRET=
CAMARA_SIM_SWAP_ENABLED=true
CAMARA_CALL_FORWARDING_ENABLED=true
CAMARA_NUMBER_VERIFICATION_ENABLED=true

# ---------------------------------------------------------------------------
# Channels
# ---------------------------------------------------------------------------
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# SMS / USSD aggregator (Africa's Talking / licensed UAE aggregator)
SMS_AGGREGATOR_URL=
SMS_AGGREGATOR_API_KEY=
SMS_AGGREGATOR_USERNAME=
SMS_SENDER_ID=
USSD_SHORT_CODE=

# Push (APNs / FCM)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=me.securevoiceai.shield
APNS_PRIVATE_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Auth / security
# ---------------------------------------------------------------------------
OAUTH_ISSUER=https://auth.shield.securevoiceai.me
OAUTH_AUDIENCE=shield-api
JWT_SIGNING_KEY=
MTLS_ENABLED=false
VAULT_ADDR=
VAULT_TOKEN=
KMS_KEY_ID=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=shield-api
SENTRY_DSN=
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Feature flags / modes (control plane)
# ---------------------------------------------------------------------------
SYSTEM_MODE=NORMAL                         # NORMAL | DEGRADED_DETECTION | ...
SHADOW_MODE_ENABLED=false

# ---------------------------------------------------------------------------
# Knowledge base / embeddings (pgvector)
# ---------------------------------------------------------------------------
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_EMBEDDING_DIM=1536
KB_VECTOR_STORE=pgvector                    # pgvector | qdrant
QDRANT_URL=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (Next.js public)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://shield.securevoiceai.me
NEXT_PUBLIC_API_BASE_URL=https://ug.api.shield.securevoiceai.me/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en-ug
NEXT_TELEMETRY_DISABLED=1
# Local development environment. Copy to .env and adjust.
# SQLite path is relative to prisma/schema.prisma, so it works on any machine.
DATABASE_URL=file:../db/custom.db

# Per-cell pepper for phone-number HMACs. Keep it stable across restarts —
# changing it makes previously hashed numbers unmatchable.
SHIELD_CELL_PEPPER=shield-ug-sandbox-pepper

# ES256 private key (PKCS#8 PEM, newlines escaped) that signs audit entries and
# the official-channels list. Generate one with: bun run keygen
SHIELD_SIGNING_KEY="<paste the generated PEM here>"
